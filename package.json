{
  "name": "conduccion-inteligente-tiny-pro",
  "private": true,
  "version": "1.0.0",
  "description": "Conducción Inteligente — Laboratorio Tiny Pro. Simulador educativo para Yahboom Tiny:bit Pro con micro:bit y módulo K210.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "docente": "vite --mode docente --port 5181 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:docente": "tsc --noEmit && vite build --mode docente",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "figure": "node scripts/build-figure.mjs",
    "examples": "vite-node scripts/export-examples.ts"
  },
  "dependencies": {
    "blockly": "11.1.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
